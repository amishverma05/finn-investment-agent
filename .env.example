# Copy this file to .env (same folder) and paste your key.
# Several keys? Separate them with commas: each AI call picks one at random,
# and a key that hits its rate limit is swapped for another.
GEMINI_API_KEY=

# Optional: override model routing (comma-separated fallbacks).
# MODEL_CHEAP=gemini-3.5-flash-lite,gemini-flash-lite-latest
# MODEL_STRONG=gemini-3.5-flash,gemini-flash-latest

# Optional backup provider (free key at console.groq.com). Used only when both
# Gemini models of a tier are busy or don't reply in time.
GROQ_API_KEY=
# GROQ_MODEL_CHEAP=openai/gpt-oss-20b
# GROQ_MODEL_STRONG=openai/gpt-oss-120b

# Logging: INFO = every step with timings, DEBUG = also cache hits.
# Steps slower than SLOW_SECONDS are flagged "SLOW".
# LOG_LEVEL=INFO
# SLOW_SECONDS=2

# Frontend URL allowed to call the API
FRONTEND_ORIGIN=http://localhost:3000
